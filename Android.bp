package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "MikuHome-core",
    platform_apis: true,
    manifest: "AndroidManifest-res.xml",
    use_resource_processor: false,
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    // Compiled with the app so it sees the final resource ids for home-settings strings.
    exclude_srcs: [
        "src/com/miku/android/launcher/MikuLauncherSettingsFragment.java",
    ],
    static_libs: [
        "Launcher3QuickStepLib",
    ],
    resource_dirs: [],
    min_sdk_version: "current",
    kotlincflags: [
        "-Xjvm-default=all",
    ],
}

android_app {
    name: "MikuHome",
    defaults: [
        "platform_app_defaults",
    ],
    static_libs: [
        "MikuHome-core",
    ],
    srcs: [
        "src/com/miku/android/launcher/MikuLauncherSettingsFragment.java",
    ],
    optimize: {
        proguard_flags_files: [
            "proguard.flags",
            "//packages/apps/Launcher3:launcher-proguard-rules",
        ],
        enabled: true,
        shrink_resources: true,
        ignore_warnings: false,
    },

    platform_apis: true,
    min_sdk_version: "current",
    target_sdk_version: "current",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    use_resource_processor: false,

    overrides: [
        "Home",
        "Launcher2",
        "Launcher3",
        "Launcher3QuickStep",
    ],
    required: [
        "privapp_whitelist_com.android.launcher3",
        "privapp_whitelist_miku_mikuhome.xml",
        "launcher.quickstep.protolog.pb",
    ],

    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    kotlincflags: [
        "-Xjvm-default=all",
    ],
    jacoco: {
        include_filter: [
            "com.android.launcher3.*",
            "com.miku.android.launcher.*",
        ],
    },
}
